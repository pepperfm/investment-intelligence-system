# Local development defaults only; do not use these credentials on production.
NUXT_PUBLIC_SITE_URL=http://localhost:3000
DATABASE_URL=postgresql://app:app@127.0.0.1:5442/iis
NUXT_REDIS_CACHE_URL=redis://127.0.0.1:6392
NUXT_REDIS_STATE_URL=redis://127.0.0.1:6393
NUXT_REDIS_PREFIX=iis:
NUXT_AUTH_SECRET=

# Market data: "mock" (default, isolated synthetic data) or "finam" (read-only Trade API).
NUXT_MARKET_PROVIDER=mock
# Finam read-only secret. Never exposed to AI agents. Trade-write secret is not used yet.
NUXT_FINAM_READ_SECRET=
NUXT_FINAM_ACCOUNT_ID=
# Optional comma-separated research universe; IMOEX@MISX is always added.
# Empty loads all active MISX equities. Use a separate DB from mock history.
NUXT_FINAM_SYMBOLS=
# AI: "codex" (local codex exec), "claude" (local claude -p) or "mock" (deterministic offline analyst).
NUXT_AI_PROVIDER=codex
NUXT_AI_CRITIC_PROVIDER=codex
NUXT_CODEX_BIN=codex
# Explicit model/effort: the user's ~/.codex/config.toml is ignored for isolation.
NUXT_CODEX_MODEL=gpt-6.1-sol
NUXT_CODEX_REASONING_EFFORT=high
# Optional per-role overrides. Empty values inherit the global model/effort above.
NUXT_CODEX_RESEARCHER_MODEL=gpt-6-luna
NUXT_CODEX_RESEARCHER_EFFORT=medium
NUXT_CODEX_ANALYST_MODEL=gpt-6.1-sol
NUXT_CODEX_ANALYST_EFFORT=high
NUXT_CODEX_CRITIC_MODEL=gpt-6-astra
NUXT_CODEX_CRITIC_EFFORT=high
NUXT_CODEX_REVIEWER_MODEL=gpt-6.1-sol
NUXT_CODEX_REVIEWER_EFFORT=medium
NUXT_CLAUDE_BIN=claude
# Manual reserve profile; configure once, then switch in Settings without restart.
NUXT_LLMOST_BASE_URL=https://llmost.ru/api/v1
NUXT_LLMOST_API_KEY=
NUXT_LLMOST_RESEARCHER_MODEL=openai/gpt-6-luna-20260922
NUXT_LLMOST_RESEARCHER_EFFORT=medium
NUXT_LLMOST_ANALYST_MODEL=openai/gpt-6.1-sol-20260929
NUXT_LLMOST_ANALYST_EFFORT=high
NUXT_LLMOST_CRITIC_MODEL=openai/gpt-6-astra-20260903
NUXT_LLMOST_CRITIC_EFFORT=high
NUXT_LLMOST_REVIEWER_MODEL=openai/gpt-6.1-sol-20260929
NUXT_LLMOST_REVIEWER_EFFORT=medium
NUXT_AI_TIMEOUT_MS=600000
# Embeddings: "hash" (local, deterministic) or "openai" (OpenAI-compatible /embeddings endpoint).
NUXT_EMBEDDING_PROVIDER=hash
NUXT_EMBEDDING_URL=
NUXT_EMBEDDING_KEY=
NUXT_EMBEDDING_MODEL=

# Local, bounded PDF extraction; install Poppler (brew install poppler). No cloud upload.
NUXT_PDF_TEXT_BIN=pdftotext
# Bun production runtime: allow explicit evidence refresh to finish during network failures.
NITRO_BUN_IDLE_TIMEOUT=255
